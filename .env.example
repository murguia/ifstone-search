# OpenAI API Key
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Postgres + pgvector serving layer
# Local: postgresql://localhost/ifstone   Production: the Supabase connection string
DATABASE_URL=your_postgres_connection_string_here

# Optional: research-planner model (default gpt-4o); e.g. gpt-4o-mini to cut cost
# AGENT_MODEL=gpt-4o-mini
